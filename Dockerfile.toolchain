# The build toolchain, pinned.
#
# `rust:slim` installs rustup with the minimal profile, which leaves out
# `rustfmt` and `clippy` — and both are gates here, so they have to be present
# before the gate can run. Adding them in a layer on top of a digest keeps the
# compiler exactly as pinned while making the image usable.
#
# Built on demand by `./x`; the layer is cached after the first run.

FROM rust@sha256:3b2879047d42784ca9403ad20c51ed3df361a50f1df96f5777d39b4e33aa65cd

RUN rustup component add rustfmt clippy
