# Every variable this Runner reads. Copy to `.env` and edit.
#
# **The list is checked against the source** by
# `every_variable_the_config_reads_is_in_the_example_and_no_others`, so an
# `AJ_*` key added to the code and not to this file reddens the gate. The keys
# without an `AJ_` prefix come from libraries the Runner links rather than from
# its own code, so they are listed by hand and the check cannot see them.
#
# **One is read by this Runner and is not a key here: `HOSTNAME`.** It supplies
# the default for `AJ_Runner__Name` and is set by the container runtime, so it
# is described where that variable is rather than offered to be typed.
#
# **This is the Runner process's environment**, for `docker run --env-file` or a
# production compose `env_file:`. It is *not* the `.env` that sits beside
# `example-runner-development-docker-compose.yaml` — that one is read by Compose
# for `${...}` substitution and shares no key with this file.
#
# A line commented out is a switch offered, not a switch set. Several of them
# below cannot be written as `KEY=false`, and each says why.


# ── Required ─────────────────────────────────────────────────────────────────

# The only variable with no default: the Runner refuses to start without it.
# Must contain `/api/`, and the check really is that broad — `…/api/v2` passes
# while the refusal names `/api/v1`.
AJ_Server__BaseUrl=http://server:8080/api/v1


# ── Identity and pools ───────────────────────────────────────────────────────

# What the panel calls this Runner. Unset it takes `$HOSTNAME`, which under
# Docker is the container id, and falls back to `algojudge-runner`.
AJ_Runner__Name=

# **The identity, and it is never rotated.** Losing it costs a re-registration
# and an administrator's approval, so this path wants a volume. The directory
# must be writable by uid 65532: the image runs as `nonroot`.
AJ_Runner__KeyPath=/var/lib/algojudge-runner/identity.key

# What this Runner evaluates. `output-only@1` is implemented and deliberately
# not in the default.
#
# **A typo here fails as silence, not as an error.** Nothing validates the
# string: the Server stores what it is told and matches work by equality alone,
# so a Runner declaring `standard-oi@1` is simply never handed anything and sits
# idle looking healthy. There is no failed job to find. Read it back in the
# panel.
AJ_Runner__ProblemTypes=standard-io@1

# Which pools this Runner belongs to, comma-separated and lowercased.
#
# **Read at the first registration and never again** — the panel owns it from
# then on, so a restart cannot move a Runner into an examination's pool.
# Commented out because naming a pool takes this Runner *out* of `default`,
# where every untagged activity's work is.
# AJ_Runner__Tags=lab-a


# ── Language images ──────────────────────────────────────────────────────────

# The block a release edits. Each is independent: anything left unset keeps its
# compiled-in default, which is the `algojudge/lang-*:local` image the
# development stack builds — not something a deployment should be running.
#
# Pin the same version the Runner is, unless there is a reason not to: that
# pairing is what the release was tested as.
AJ_Sandbox__Image__Gcc=
AJ_Sandbox__Image__Clang=
AJ_Sandbox__Image__Python=
AJ_Sandbox__Image__Pypy=

# The old name for `…__Gcc`, still read because deployments set it. It is the
# old name for one of the four, not a fifth image, and the new name wins when
# both are set.
# AJ_Sandbox__Image__Cpp=


# ── Cache ────────────────────────────────────────────────────────────────────

# Downloaded packages, keyed by checksum. **Give it a directory of its own**:
# eviction walks everything under this path and deletes by age, so a shared
# directory is a directory the Runner will empty.
AJ_Cache__Path=/var/cache/algojudge-runner

# Plain bytes, and only plain bytes — `10GiB` is not a number and the Runner
# panics on it. This is what triggers deletion under the path above, not a
# growth limit on a directory that is otherwise private.
AJ_Cache__MaxBytes=10737418240


# ── Scratch ──────────────────────────────────────────────────────────────────

# Where a job is unpacked, as this container sees it.
AJ_Work__Path=/var/lib/algojudge-runner/work

# **The same directory as the host sees it**, because the sandbox starts
# sibling containers and the daemon resolves their mounts on the host, not in
# here. Leave it unset when the two are the same path.
#
# Getting it wrong does not fail: the daemon mounts an **empty directory** and
# the submission compiles against nothing.
AJ_Work__HostPath=


# ── Container runtime ────────────────────────────────────────────────────────

# Where the daemon is. Only a `unix://…` value is honoured; anything else is
# ignored in silence and `/var/run/docker.sock` is used. This is the knob for
# Podman's socket.
DOCKER_HOST=

# **Cannot be turned off by writing a value.** The Runner asks only whether the
# variable is *present*, so `=0` and `=false` both switch it ON. The only ways
# to say no are to leave it absent or to give it an empty value.
#
# What it turns on: **starting** on a host this Runner cannot measure on — cgroup
# v1, a cgroup driver it knows neither of, or a cgroup tree it cannot use. It
# does not turn on judging. A time limit is decided on processor time read from a
# cgroup, so such a Runner registers, answers the protocol, and then fails every
# job it claims with an infrastructure error. That is exactly what a conformance
# suite needs and nothing more.
#
# **Both cgroup drivers are supported**, `cgroupfs` and `systemd`, so no daemon
# needs reconfiguring for this. What both need is the host's cgroup tree mounted
# writable, `--cgroupns=host`, and a container running as root.
#
# **The limits are still enforced** on all three — measured, not assumed: a
# container over its memory limit is OOM-killed and the whole adversarial suite
# passes on v1. What is missing is the reading, and the reading is what a verdict
# is made of. See docs/CGROUP_V2.md.
# AJ_Sandbox__AllowUnmeasured=1

# **An accepted alias for the line above.** It names one of the three conditions
# the refusal covers rather than all of them, so prefer the name above; a
# development `.env` carrying this one keeps working.
# AJ_Sandbox__AllowCgroupV1=1

# Where the cgroup tree is mounted, and it must be **absolute**. An empty value
# is treated as unset. A relative one would be a path the Runner writes through
# while the daemon resolves a cgroup parent against its own root, so the
# measurement would read a directory the daemon has never heard of rather than
# failing — and a verdict is made of that reading.
# AJ_Sandbox__CgroupRoot=/sys/fs/cgroup


# ── Timing ───────────────────────────────────────────────────────────────────

# Safe to leave alone. Both polling numbers are advisory rather than checked:
# `0` for the minimum is ten requests a second against a 100 ms floor, and a
# maximum below the minimum is silently raised instead of refused.
AJ_Poll__MinSeconds=1
AJ_Poll__MaxSeconds=30

# How long the Server may hold a `claim` open while the queue is empty, in
# seconds. This is what makes a submission start being judged **now** rather
# than at the next poll, and it makes the two numbers above matter only after a
# failure.
#
# **The ceiling is not this Server; it is whatever sits between.** A held claim
# sends nothing, and an intermediary that measures silence cuts it:
#
#     Azure Application Gateway   20 s   (its backend request timeout)
#     nginx, AWS ALB              60 s
#     Cloudflare                 125 s   (then HTTP 524)
#     this Server                300 s   (its own ceiling)
#
# Twenty-five clears all of them. An installation that owns its whole path — the
# Compose stack, where the only proxy is its own nginx at 3600 s — may raise it
# to 300 and cost two requests every ten minutes per idle Runner. One behind a
# proxy it does not control may have to lower it. `0` asks for no wait at all
# and falls back to the interval above.
#
# **The Server's 300 is refused at start-up, not clamped.** Asking for more is
# worse than being ignored: this Runner tells a held claim from an immediate
# answer by how long it took, so one asking for 900 would read the Server's 300
# as no wait at all and sleep the backoff above after every claim.
AJ_Poll__WaitSeconds=25
AJ_Heartbeat__Seconds=60

# A request, not a grant: the Server clamps it to between 60 and 3600.
AJ_Lease__RequestSeconds=600


# ── Logging ──────────────────────────────────────────────────────────────────

# A malformed filter falls back to `info` rather than failing to start.
RUST_LOG=info

# The only thing deciding whether the container's logs carry ANSI colour — the
# Runner never sets it in code. Blank behaves as unset, so this line is off.
NO_COLOR=


# ── Proxy ────────────────────────────────────────────────────────────────────

# Read by the HTTP client, not by the Runner. All blank-safe. Remember that
# `scheme://user:pass@host` is valid for each of the three, so all three can
# carry a credential into a process listing.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=


# ── Do not set these ─────────────────────────────────────────────────────────
#
# Deliberately written without an `=`, so that copying this file cannot set them.
#
#   REQUEST_METHOD          Setting it at all — an empty value included — makes
#                           the HTTP client believe it is running as CGI and
#                           discard the whole proxy configuration above,
#                           including HTTPS.
#
#   TOKIO_WORKER_THREADS    An empty value or `0` panics inside the runtime
#                           before any of this Runner's own code runs.

# Where a judged run channels are made, when the work directory will not hold
# them. A judged run output travels on a named pipe, which holds no bytes, so
# this is not about space -- it is about a filesystem that can make a pipe. A
# bind mount of a Windows or macOS directory cannot, which is a developer
# machine and not a deployment. Absent leaves them in the job own scratch.
# Set both or neither: the daemon resolves the bind, so where this Runner is
# itself in a container the two views differ. A `tmpfs:` entry on this service
# will not do -- that is private to the Runner mount namespace, and the daemon
# would make an empty directory instead.
AJ_Pipes__Path=
AJ_Pipes__HostPath=
